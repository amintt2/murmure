{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmure",
  "version": "0.2.0",
  "identifier": "fr.mciut.murmure",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Murmure",
        "url": "index.html",
        "width": 500,
        "height": 640,
        "minWidth": 440,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Murmure",
        "url": "overlay.html",
        "width": 560,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 300,
          "y": 200
        },
        "appPosition": {
          "x": 165,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 200
        }
      },
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "runtimes/llama-cpp": "runtimes/llama-cpp",
      "runtimes/whisper-cpp": "runtimes/whisper-cpp"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Dictée locale hors-ligne",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRDA1Mjc4NzYwRDkwQ0IKUldUTGtBMTJlRkxRd0ZvSTNUR09Cc2c1VWRlRCtKcTZvTU13WkFiQUFFZDRBUHF3QitLL0ZrRGMK",
      "endpoints": [
        "https://github.com/amintt2/murmure/releases/latest/download/latest.json"
      ]
    }
  }
}